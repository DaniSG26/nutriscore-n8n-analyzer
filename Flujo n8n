        "jsCode": "\nconst nutriscore = String($('Obtener - Valores nutricionales').item.json.product.nutriscore_grade ?? \"\").trim().toLowerCase();\n\nlet clasificacionNutriScore = \"null\";\n\nif (nutriscore === \"a\" || nutriscore === \"b\") {\n  clasificacionNutriScore = \"saludable\";\n} else if (nutriscore === \"c\") {\n  clasificacionNutriScore = \"moderado\";\n} else if (nutriscore === \"d\" || nutriscore === \"e\") {\n  clasificacionNutriScore = \"no saludable\";\n}\n\nreturn {\n  json: {\n    ...$json,\n    clasificacionNutriScore\n  }\n};"
