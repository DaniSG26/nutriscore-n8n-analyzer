      "parameters": {
        "jsCode": "const azucar = Number($json.sugar);\nconst sal = Number($json.salt);\nconst grasa = Number($json.fat);\n\n// Comprobar que los tres nutrientes tienen valores válidos\nif (\n  [azucar, sal, grasa].some(valor => !Number.isFinite(valor)) ||\n  [$json.sugar, $json.salt, $json.fat].some(\n    valor => valor === undefined || valor === null || valor === \"\"\n  ) ||\n  [azucar, sal, grasa].some(valor => valor < 0)\n) {\n  throw new Error(\"Faltan nutrientes o sus valores no son válidos\");\n}\n\n// Identificar nutrientes altos\nconst azucarAlto = azucar > 22.5;\nconst salAlta = sal > 1.5;\nconst grasaAlta = grasa > 17.5;\n\n// Contar cuántos nutrientes son altos (de 0 a 3)\nconst puntuacion = Number(azucarAlto) +\n                   Number(salAlta) +\n                   Number(grasaAlta);\n\n// Clasificar producto\nlet clasificacion;\nlet semaforo;\n\nif (puntuacion === 0) {\n  clasificacion = \"saludable\";\n  semaforo = \"🟢\";\n} else if (puntuacion === 1) {\n  clasificacion = \"moderado\";\n  semaforo = \"🟠\";\n} else {\n  clasificacion = \"no saludable\";\n  semaforo = \"🔴\";\n}\n\n// Devolver resultado\nreturn {\n  json: {\n    azucar,\n    sal,\n    grasa,\n    puntuacion,\n    clasificacion,\n    semaforo\n  }\n};"
      },
